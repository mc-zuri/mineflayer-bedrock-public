{
  "name": "mineflayer",
  "version": "4.39.0",
  "description": "create minecraft bots with a stable, high level API",
  "main": "index.ts",
  "type": "module",
  "types": "index.d.ts",
  "scripts": {
    "mocha_test": "mocha --reporter ./test/common/durationsReporter.ts --extension ts --spec \"test/*.ts\" --exit",
    "test": "npm run mocha_test",
    "pretest": "npm run lint",
    "typecheck": "node node_modules/typescript7/bin/tsc -p .",
    "lint": "npm run typecheck && eslint . && standard-markdown",
    "fix": "eslint . --fix && standard-markdown --fix",
    "prepublishOnly": "cp docs/README.md README.md"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/PrismarineJS/mineflayer.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "license": "MIT",
  "dependencies": {
    "minecraft-data": "file:../node-minecraft-data",
    "minecraft-protocol": "^1.67.0",
    "mojangson": "^2.0.4",
    "prismarine-biome": "^1.1.1",
    "prismarine-block": "^1.22.0",
    "prismarine-chat": "^1.7.1",
    "prismarine-chunk": "^1.41.0",
    "prismarine-entity": "^2.5.0",
    "prismarine-item": "^1.17.0",
    "prismarine-nbt": "^2.0.0",
    "prismarine-physics": "^1.11.1",
    "prismarine-recipe": "^1.5.0",
    "prismarine-registry": "^1.10.0",
    "prismarine-windows": "^2.9.0",
    "prismarine-world": "^3.6.0",
    "protodef": "^1.18.0",
    "typed-emitter": "^1.0.0",
    "uuid-1345": "^1.0.2",
    "vec3": "^0.1.7"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.2.1",
    "doctoc": "^2.0.1",
    "eslint": "^9.39.0",
    "minecraft-wrap": "^1.3.0",
    "mineflayer": "./",
    "mocha": "^11.0.1",
    "neostandard": "^0.13.0",
    "protodef-yaml": "^1.5.3",
    "standard-markdown": "^7.1.0",
    "typescript": "~6.0.3",
    "typescript7": "npm:typescript@^7.0.2"
  }
}
